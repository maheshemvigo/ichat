# Copy to .env before running Docker (or merge these values into your existing .env):
#   cp .env.docker.example .env
#
# Docker Compose also sets DB_* via environment (overrides .env for DB_HOST).

APP_NAME=PatonMedicalGroup
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ichat
DB_USERNAME=ichat
DB_PASSWORD=ichat_secret

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Add your mail / Pusher settings from .env.dev as needed

# Queue (required for End Simulation → LLM report → S3)
# Run: docker compose up -d queue

# AWS S3 (summary reports stored private; app serves pre-signed download URLs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=ichat-lbs

# Structured AI report (OpenAI-compatible API)
LLM_REPORT_ENABLED=true
LLM_API_KEY=sk-your-openai-key
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_CHUNK_MESSAGE_LIMIT=40
LLM_CHUNK_CHAR_LIMIT=12000
LLM_TIMEOUT=120
LLM_SIMULATION_MAX_LLM_LINES=500
LLM_REPORT_S3_PREFIX=simulation-history-reports
LLM_REPORT_SIGNED_URL_MINUTES=60

# PostHog (server-side pageviews + exceptions via posthog/posthog-php)
POSTHOG_ENABLED=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
